+def phase_selection(phases):
+    selected=list(('main','scale') if phases is None else phases)
+    require(selected and len(selected)==len(set(selected)) and set(selected)<=set(('main','scale')),
+        'nonempty unique predecessor phase selection required')
+    return [p for p in ('main','scale') if p in selected]
