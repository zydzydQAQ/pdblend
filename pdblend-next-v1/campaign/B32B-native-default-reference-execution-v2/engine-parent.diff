+    async def native_reference(self, request):
+        body=await request.json()
+        spec_path=Path(os.environ['PDBLEND_DIAGNOSTIC_SPEC'])
+        if hashlib.sha256(spec_path.read_bytes()).hexdigest()!=os.environ['PDBLEND_DIAGNOSTIC_SPEC_SHA256']:
+            raise web.HTTPConflict(text='reference spec SHA changed')
+        spec=json.loads(spec_path.read_text())
+        if body.get('requests')!=spec['requests'] or set(body)!= {'requests','work_deadline_s'}:
+            raise web.HTTPBadRequest(text='exact four request declaration required')
+        end=body['work_deadline_s']
+        if type(end) not in (int,float) or not time.time()<end<=spec['global_deadline_s'] or end-time.time()>390.1:
+            raise web.HTTPBadRequest(text='bounded actual deadline required')
+        async with self.control_lock:
+            if getattr(self,'native_reference_claimed',False):
+                raise web.HTTPConflict(text='one reference only; no retry')
+            if self.streams or self.error or not self.accepting:
+                raise web.HTTPConflict(text='reference owner not idle')
+            self.native_reference_claimed=True
+            return web.json_response(await self.call(self.native_reference_work,body,timeout_s=end-time.time()))
