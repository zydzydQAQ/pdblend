+    def native_reference_work(self, payload):
+        # Runs exclusively on the existing owner executor, not its HTTP loop.
+        from native_driver import run_reference
+        from vllm import SamplingParams
+        now=time.time();end=payload['work_deadline_s']
+        if not (now<end<=1788872770.0400891 and end-now<=390.1):
+            raise RuntimeError('reference absolute work deadline')
+        mono=time.monotonic()+end-now
+        def guard():
+            if time.time()>=end or time.monotonic()>=mono:
+                raise TimeoutError('native reference wall/monotonic deadline')
+        path=self.runtime_path.parent/'native-reference.events.jsonl'
+        with path.open('x',buffering=1) as events:
+            def emit(value):
+                events.write(json.dumps(value,allow_nan=False)+'\n')
+            try:
+                return run_reference(self.engine,payload['requests'],SamplingParams,emit,guard)
+            finally:
+                self.update_snapshot()
